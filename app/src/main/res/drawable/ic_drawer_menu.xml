        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <size android:width="22dp" android:height="2dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <size android:width="22dp" android:height="2dp" />
        </shape>
    </item>
    <item android:gravity="center_horizontal|bottom" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <size android:width="22dp" android:height="2dp" />
        </shape>
    </item>
</layer-list>

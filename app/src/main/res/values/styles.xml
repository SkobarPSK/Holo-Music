<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Базовая тема — классический Holo Dark, без Material -->
    <style name="AppTheme.Holo.Dark" parent="android:Theme.Holo">
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:actionBarStyle">@style/ActionBar.Holo.Dark</item>
        <item name="android:actionBarTabStyle">@style/ActionBarTab.Holo.Dark</item>
        <item name="android:actionBarTabTextStyle">@style/ActionBarTabText.Holo.Dark</item>
        <item name="android:listViewStyle">@style/ListView.Holo.Dark</item>
        <item name="android:progressBarStyleHorizontal">@android:style/Widget.Holo.ProgressBar.Horizontal</item>
        <item name="android:seekBarStyle">@style/SeekBar.Holo.Dark</item>
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:colorAccent">@color/holo_blue</item>
    </style>

    <style name="ActionBar.Holo.Dark" parent="android:Widget.Holo.ActionBar">
        <item name="android:background">@color/actionbar_grey</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle.Holo.Dark</item>
    </style>

    <style name="ActionBarTitle.Holo.Dark" parent="android:TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ActionBarTab.Holo.Dark" parent="android:Widget.Holo.ActionBar.TabView">
        <item name="android:background">@drawable/tab_indicator_holo</item>
    </style>

    <style name="ActionBarTabText.Holo.Dark" parent="android:TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ListView.Holo.Dark" parent="android:Widget.Holo.ListView">
        <item name="android:divider">@color/divider_grey</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:listSelector">@drawable/list_selector_holo</item>
        <item name="android:background">@color/bg_black</item>
    </style>

    <style name="SeekBar.Holo.Dark" parent="android:Widget.Holo.SeekBar">
        <!-- Прогресс-бар и ползунок наследуются из родительского Holo-стиля.
             Явная ссылка на @android:drawable/scrubber_control_selector_holo_dark
             и progress_horizontal_holo_dark убрана: это приватные ресурсы
             фреймворка, и некоторые сборки aapt2 (например, в CodeAssist)
             не могут их слинковать, хотя на устройстве они существуют. -->
    </style>

    <style name="TrackTitleText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TrackSubtitleText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PlayerIconButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/list_selector_holo</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PlayerIconButton.Large">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/play_button_bg</item>
    </style>

    <style name="PlayerIconButton.Small">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:layout_marginRight">6dp</item>
    </style>

</resources>

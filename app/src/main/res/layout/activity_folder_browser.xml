<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_black">

    <LinearLayout
        android:id="@+id/storage_roots_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_dark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/text_current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/actionbar_grey"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="start"
        android:padding="10dp" />

    <ListView
        android:id="@+id/list_folders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@color/divider_grey"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/list_selector_holo" />

    <Button
        android:id="@+id/btn_select_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_this_folder"
        android:textColor="@color/holo_blue"
        android:background="@drawable/list_selector_holo"
        android:padding="14dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/drawer_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/actionbar_grey"
            android:padding="20dp"
            android:text="@string/app_name"
            android:textColor="@color/holo_blue"
            android:textSize="18sp" />

        <ListView
            android:id="@+id/list_drawer_sections"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider_grey"
            android:dividerHeight="1dp"
            android:layoutAnimation="@anim/list_layout_animation"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@drawable/list_selector_holo" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/divider_grey" />

</FrameLayout>
